rules_version = '2';

// ============================================================================
// Clínica Dental Aurora — Firestore (modo directo, sin Cloud Functions)
// ----------------------------------------------------------------------------
// El proyecto no usa Blaze. El rol se lee SIEMPRE del perfil users/{uid},
// nunca de datos enviados por el navegador. El cliente puede escribir citas,
// consultas y pagos de forma directa, pero las reglas limitan quién y qué.
//
// Limitaciones asumidas de este modo:
//  * No hay transacciones de servidor: la comprobación de solapamientos se hace
//    en una transacción del cliente y puede ser eludida por un cliente alterado.
//  * No hay Cloud Storage: los documentos binarios no están disponibles.
//  * No hay triggers: notificaciones, resúmenes y auditoría se escriben desde
//    el propio cliente autorizado.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function myUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function role() {
      return signedIn() && exists(userPath(request.auth.uid)) ? myUser().role : '';
    }

    function accountActive() {
      return signedIn() && exists(userPath(request.auth.uid)) && myUser().status == 'active';
    }

    function isAdmin() {
      return accountActive() && role() == 'admin';
    }

    function isReception() {
      return accountActive() && role() == 'reception';
    }

    function isDentist() {
      return accountActive() && role() == 'dentist';
    }

    function isPatient() {
      return accountActive() && role() == 'patient';
    }

    function isStaff() {
      return isAdmin() || isReception() || isDentist();
    }

    function isClinical() {
      return isAdmin() || isDentist();
    }

    function isAdminOrReception() {
      return isAdmin() || isReception();
    }

    function myDentistId() {
      return accountActive() ? myUser().dentistId : '';
    }

    function patientPath(pid) {
      return /databases/$(database)/documents/patients/$(pid);
    }

    function patientExists(pid) {
      return exists(patientPath(pid));
    }

    function patientData(pid) {
      return get(patientPath(pid)).data;
    }

    function ownsPatient(pid) {
      return isPatient() && patientExists(pid) && (
        pid == request.auth.uid ||
        patientData(pid).userId == request.auth.uid
      );
    }

    function assignedDentist(pid) {
      return isDentist() && patientExists(pid) && (
        (myDentistId() != '' && patientData(pid).assignedDentistId == myDentistId()) ||
        (patientData(pid).careTeamIds is list && myDentistId() in patientData(pid).careTeamIds)
      );
    }

    function validRole(r) {
      return r in ['patient', 'admin', 'reception', 'dentist'];
    }

    function validStatus(s) {
      return s in ['active', 'inactive', 'suspended'];
    }

    function validAppointmentStatus(s) {
      return s in ['pending', 'confirmed', 'cancelled', 'done'];
    }

    function validPaymentStatus(s) {
      return s in ['pending', 'paid', 'refunded', 'void'];
    }

    function validDocumentType(t) {
      return t in ['radiograph', 'photo', 'consent', 'invoice', 'admin', 'document'];
    }

    function isDateString(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTimeString(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isEmail(v) {
      return v is string && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function maxLen(v, n) {
      return v is string && v.size() <= n;
    }

    function noCardData(data) {
      return !data.keys().hasAny([
        'cardNumber', 'pan', 'cvv', 'cvc', 'expiry', 'cardExpiry',
        'iban', 'accountNumber', 'stripeSecret'
      ]);
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();

      allow create: if (
        // Autorregistro de paciente.
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.role == 'patient' &&
          request.resource.data.status == 'active' &&
          request.resource.data.patientId == userId &&
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'name', 'phone', 'role', 'status', 'patientId',
            'dentistId', 'preferences', 'createdAt', 'updatedAt', 'lastLoginAt'
          ])
        ) ||
        // Alta de personal por un administrador.
        (isAdmin() &&
          request.resource.data.uid == userId &&
          validRole(request.resource.data.role) &&
          validStatus(request.resource.data.status) &&
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'name', 'phone', 'role', 'status', 'patientId',
            'dentistId', 'preferences', 'createdAt', 'updatedAt', 'createdBy'
          ]) &&
          isEmail(request.resource.data.email)
        )
      );

      allow update: if (
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'preferences', 'accessibility',
            'updatedAt', 'lastLoginAt', 'photoPath'
          ]) &&
          (!('name' in request.resource.data) || (
            request.resource.data.name is string &&
            request.resource.data.name.size() >= 2 &&
            request.resource.data.name.size() <= 120
          )) &&
          (!('phone' in request.resource.data) || maxLen(request.resource.data.phone, 30)) &&
          (!('preferences' in request.resource.data) || request.resource.data.preferences is map)
        ) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'role', 'status', 'patientId', 'dentistId',
            'preferences', 'accessibility', 'updatedAt', 'updatedBy', 'photoPath'
          ]) &&
          (!('role' in request.resource.data) || validRole(request.resource.data.role)) &&
          (!('status' in request.resource.data) || validStatus(request.resource.data.status))
        )
      );

      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------- patients
    match /patients/{patientId} {
      allow get: if isAdminOrReception() ||
        (isPatient() && request.auth.uid == patientId) ||
        (isPatient() && resource.data.userId == request.auth.uid) ||
        assignedDentist(patientId);

      allow list: if isAdminOrReception() ||
        (isDentist() && resource.data.assignedDentistId == myDentistId());

      allow create: if (
        (isAdminOrReception() || (
          patientId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        )) &&
        request.resource.data.keys().hasAll(['fn', 'ln', 'em', 'status']) &&
        request.resource.data.keys().hasOnly([
          'fn', 'ln', 'bd', 'ph', 'em', 'addr', 'assignedDentistId',
          'userId', 'status', 'adminNotes', 'careTeamIds', 'createdAt',
          'updatedAt', 'createdBy', 'updatedBy', 'demo', 'legacyId', 'searchName',
          'migrated'
        ]) &&
        request.resource.data.fn is string && request.resource.data.fn.size() > 0 &&
        request.resource.data.fn.size() <= 80 &&
        request.resource.data.ln is string && request.resource.data.ln.size() > 0 &&
        request.resource.data.ln.size() <= 120 &&
        isEmail(request.resource.data.em) &&
        maxLen(request.resource.data.ph, 30) &&
        maxLen(request.resource.data.addr, 300) &&
        validStatus(request.resource.data.status) &&
        noCardData(request.resource.data)
      );

      allow update: if (
        (isAdminOrReception() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fn', 'ln', 'bd', 'ph', 'em', 'addr', 'assignedDentistId',
            'userId', 'status', 'adminNotes', 'careTeamIds', 'updatedAt',
            'updatedBy', 'searchName'
          ]) &&
          (!('em' in request.resource.data) || isEmail(request.resource.data.em)) &&
          (!('status' in request.resource.data) || validStatus(request.resource.data.status)) &&
          noCardData(request.resource.data)
        ) ||
        (ownsPatient(patientId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ph', 'addr', 'updatedAt']) &&
          maxLen(request.resource.data.ph, 30) &&
          maxLen(request.resource.data.addr, 300)
        )
      );

      allow delete: if isAdmin();

      // Metadatos de documentos. En modo directo no hay Storage; se conserva
      // la colección para futuras migraciones y para facturas administrativas.
      match /documents/{documentId} {
        allow get: if isAdmin() ||
          (isClinical() && assignedDentist(patientId)) ||
          (isReception() && resource.data.type in ['invoice', 'admin']) ||
          (ownsPatient(patientId) && resource.data.visibleToPatient == true);

        allow list: if isAdmin() ||
          (isClinical() && assignedDentist(patientId)) ||
          (isReception() && resource.data.type in ['invoice', 'admin']) ||
          (ownsPatient(patientId) && resource.data.visibleToPatient == true);

        allow create, update: if (
          (isAdmin() ||
            (isReception() && request.resource.data.type in ['invoice', 'admin']) ||
            (isDentist() && assignedDentist(patientId) &&
              request.resource.data.type in ['radiograph', 'photo', 'consent', 'document', 'invoice'])
          ) &&
          request.resource.data.patientId == patientId &&
          request.resource.data.keys().hasOnly([
            'patientId', 'consultationId', 'type', 'fileName', 'contentType',
            'size', 'storagePath', 'visibleToPatient', 'uploadedBy',
            'createdAt', 'updatedAt', 'description'
          ]) &&
          validDocumentType(request.resource.data.type) &&
          request.resource.data.size is number &&
          request.resource.data.size <= 26214400 &&
          request.resource.data.storagePath is string &&
          noCardData(request.resource.data)
        );

        allow delete: if isAdmin();
      }

      match /messages/{messageId} {
        allow get, list: if isAdminOrReception() ||
          assignedDentist(patientId) ||
          ownsPatient(patientId);

        allow create: if (isAdminOrReception() ||
          assignedDentist(patientId) ||
          ownsPatient(patientId)) &&
          request.resource.data.patientId == patientId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'patientId', 'senderId', 'senderRole', 'senderName', 'body',
            'createdAt', 'readBy'
          ]) &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 4000 &&
          request.resource.data.senderRole == role();

        allow update: if (isAdminOrReception() ||
          assignedDentist(patientId) ||
          ownsPatient(patientId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

        allow delete: if isAdmin();
      }
    }

    // ----------------------------------------------------------- appointments
    match /appointments/{appointmentId} {
      allow get: if isAdminOrReception() ||
        (isDentist() && resource.data.dentistId == myDentistId()) ||
        (isPatient() && ownsPatient(resource.data.patientId));

      allow list: if isAdminOrReception() ||
        (isDentist() && resource.data.dentistId == myDentistId()) ||
        (isPatient() && ownsPatient(resource.data.patientId));

      allow create: if isAdminOrReception() &&
        request.resource.data.patientId is string &&
        patientExists(request.resource.data.patientId) &&
        request.resource.data.keys().hasAll(['patientId', 'treatment', 'dentistId', 'date', 'time', 'status']) &&
        request.resource.data.keys().hasOnly([
          'patientId', 'patientName', 'treatment', 'treatmentName', 'dentistId',
          'dentistUid', 'dentistName', 'date', 'time', 'status', 'box', 'note',
          'req', 'requestId', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        isDateString(request.resource.data.date) &&
        isTimeString(request.resource.data.time) &&
        validAppointmentStatus(request.resource.data.status) &&
        noCardData(request.resource.data);

      allow update: if (
        (isAdminOrReception() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'patientId', 'patientName', 'treatment', 'treatmentName', 'dentistId',
            'dentistUid', 'dentistName', 'date', 'time', 'status', 'box', 'note',
            'req', 'requestId', 'updatedAt', 'updatedBy'
          ]) &&
          (!('date' in request.resource.data) || isDateString(request.resource.data.date)) &&
          (!('time' in request.resource.data) || isTimeString(request.resource.data.time)) &&
          (!('status' in request.resource.data) || validAppointmentStatus(request.resource.data.status))
        ) ||
        (isDentist() &&
          resource.data.dentistId == myDentistId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']) &&
          validAppointmentStatus(request.resource.data.status)
        ) ||
        (isPatient() && ownsPatient(resource.data.patientId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['req', 'updatedAt'])
        )
      );

      allow delete: if isAdminOrReception();
    }

    // Proyección pública sin datos del paciente. La mantiene el personal al
    // crear/cancelar citas. Solo contiene fecha, hora y odontólogo.
    match /bookedSlots/{slotId} {
      allow read: if true;
      allow create, update: if (isAdminOrReception() ||
        (isDentist() && request.resource.data.dentistId == myDentistId())) &&
        request.resource.data.keys().hasOnly([
          'date', 'time', 'dentistId', 'appointmentId', 'status', 'updatedAt'
        ]) &&
        isDateString(request.resource.data.date) &&
        isTimeString(request.resource.data.time);
      allow delete: if isAdminOrReception() ||
        (isDentist() && resource.data.dentistId == myDentistId());
    }

    // ----------------------------------------------------------- consultations
    match /consultations/{consultationId} {
      allow get, list: if isAdmin() ||
        (isDentist() && (
          resource.data.dentistId == myDentistId() ||
          assignedDentist(resource.data.patientId)
        ));

      allow create: if isClinical() &&
        patientExists(request.resource.data.patientId) &&
        request.resource.data.keys().hasAll([
          'patientId', 'date', 'treatment', 'dentistId', 'notes',
          'diagnosis', 'plan', 'evolution', 'share', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'patientId', 'patientName', 'appointmentId', 'date', 'treatment',
          'treatmentName', 'dentistId', 'dentistUid', 'dentistName', 'notes',
          'diagnosis', 'plan', 'evolution', 'sharedSummary', 'share',
          'attachments', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
          'visibleToPatient'
        ]) &&
        isDateString(request.resource.data.date) &&
        (isAdmin() || (isDentist() &&
          assignedDentist(request.resource.data.patientId) &&
          request.resource.data.dentistId == myDentistId())) &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() > 0 &&
        request.resource.data.notes.size() <= 20000 &&
        noCardData(request.resource.data);

      allow update: if isClinical() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appointmentId', 'date', 'treatment', 'notes', 'diagnosis', 'plan',
          'evolution', 'sharedSummary', 'share', 'attachments',
          'updatedAt', 'updatedBy', 'visibleToPatient'
        ]) &&
        (isAdmin() || (isDentist() &&
          assignedDentist(resource.data.patientId) &&
          resource.data.dentistId == myDentistId())) &&
        noCardData(request.resource.data);

      allow delete: if isAdmin();
    }

    match /clinicalSummaries/{summaryId} {
      allow get: if isAdmin() ||
        (isDentist() && resource.data.dentistId == myDentistId()) ||
        (isPatient() && ownsPatient(resource.data.patientId));

      allow list: if isAdmin() ||
        (isDentist() && resource.data.dentistId == myDentistId()) ||
        (isPatient() && ownsPatient(resource.data.patientId));

      allow create, update: if isClinical() &&
        request.resource.data.patientId is string &&
        request.resource.data.consultationId is string &&
        request.resource.data.summary is string &&
        request.resource.data.summary.size() <= 5000 &&
        (isAdmin() || request.resource.data.dentistId == myDentistId()) &&
        noCardData(request.resource.data);

      allow delete: if isClinical();
    }

    // --------------------------------------------------------------- payments
    match /payments/{paymentId} {
      allow get: if isAdminOrReception() ||
        (isPatient() && ownsPatient(resource.data.patientId));

      allow list: if isAdminOrReception() ||
        (isPatient() && ownsPatient(resource.data.patientId));

      allow create: if isAdminOrReception() &&
        request.resource.data.keys().hasAll(['patientId', 'concept', 'amount', 'status', 'date', 'createdAt']) &&
        request.resource.data.keys().hasOnly([
          'patientId', 'patientName', 'treatment', 'concept', 'amount', 'status',
          'date', 'invoiceNumber', 'invoicePath', 'notes', 'createdAt',
          'updatedAt', 'createdBy', 'updatedBy', 'paidAt', 'paidBy'
        ]) &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 100000 &&
        validPaymentStatus(request.resource.data.status) &&
        isDateString(request.resource.data.date) &&
        noCardData(request.resource.data);

      allow update: if isAdminOrReception() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'invoiceNumber', 'invoicePath', 'notes', 'paidAt',
          'paidBy', 'updatedAt', 'updatedBy'
        ]) &&
        (!('status' in request.resource.data) || validPaymentStatus(request.resource.data.status)) &&
        noCardData(request.resource.data);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- requests
    match /requests/{requestId} {
      allow get, list: if isAdminOrReception() ||
        (isDentist() && resource.data.dentistId == myDentistId()) ||
        (isPatient() && ownsPatient(resource.data.patientId));

      // Reserva o contacto público directo. No hay Functions ni rate limiting;
      // se valida el contenido y que el timestamp sea del servidor.
      allow create: if request.resource.data.keys().hasAll(['kind', 'name', 'status', 'createdAt']) &&
        request.resource.data.kind in ['booking', 'callback', 'change'] &&
        request.resource.data.status == 'new' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 3 &&
        request.resource.data.name.size() <= 120 &&
        maxLen(request.resource.data.phone, 30) &&
        maxLen(request.resource.data.email, 254) &&
        maxLen(request.resource.data.msg, 1000) &&
        request.resource.data.keys().hasOnly([
          'kind', 'ref', 'name', 'phone', 'email', 'treatment', 'dentistId',
          'prefDentist', 'date', 'time', 'msg', 'channel', 'when', 'patientId',
          'appointmentId', 'status', 'source', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.createdAt == request.time &&
        noCardData(request.resource.data);

      allow update: if isAdminOrReception() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'patientId', 'appointmentId', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.status in ['new', 'accepted', 'rejected', 'expired'];

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------- catalog
    match /treatments/{treatmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /dentists/{dentistId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/clinic {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      allow get, list: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isStaff() &&
        request.resource.data.userId is string &&
        request.resource.data.keys().hasOnly([
          'userId', 'type', 'title', 'body', 'link', 'read', 'createdAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 1200 &&
        request.resource.data.createdAt == request.time;

      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read == true;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------- audit
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isStaff() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == role() &&
        request.resource.data.at == request.time &&
        noCardData(request.resource.data);
      allow update, delete: if false;
    }

    // ------------------------------------------------------- internal / server
    match /scheduleLocks/{lockId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /backups/{backupId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
